# ============================================================
# 配置模板
#
# 用法：复制本文件为 .env，填入真实值。
# .env 已在 .gitignore 中，不会入库。
#
# 本文件只含占位符，严禁填入任何真实凭据。
#
# 命名规则：CBE_<段名>__<字段名>，段名与字段名均为大写。
# 未在此声明的变量会导致启动报错，这是有意为之——
# 变量名写错时应当立刻失败，而不是静默套用默认值。
# ============================================================

# ---------- Milvus（VM 上的向量库，无认证）----------
CBE_MILVUS__HOST=192.168.88.101
CBE_MILVUS__PORT=19530
CBE_MILVUS__DATABASE=cbe_compliance
CBE_MILVUS__COLLECTION=chunks_v1
CBE_MILVUS__TIMEOUT_SECONDS=10

# ---------- Redis（VM 上，需要密码）----------
CBE_REDIS__HOST=192.168.88.101
CBE_REDIS__PORT=6379
CBE_REDIS__PASSWORD=<填写真实密码>
CBE_REDIS__KEY_PREFIX=cbe
CBE_REDIS__SESSION_TTL_SECONDS=3600
CBE_REDIS__CACHE_TTL_SECONDS=600
CBE_REDIS__LOCK_TTL_SECONDS=300
CBE_REDIS__TIMEOUT_SECONDS=5

# ---------- MongoDB（VM 上，需要密码，M2 阶段启用）----------
CBE_MONGODB__HOST=192.168.88.101
CBE_MONGODB__PORT=27017
CBE_MONGODB__USER=<填写用户名>
CBE_MONGODB__PASSWORD=<填写真实密码>
CBE_MONGODB__DATABASE=cbe_compliance
# 认证库：账号建在 admin 库时保持默认；若建在业务库里则改成业务库名
CBE_MONGODB__AUTH_SOURCE=admin
CBE_MONGODB__TIMEOUT_SECONDS=10

# ---------- MySQL（宿主机，需要密码）----------
CBE_MYSQL__HOST=127.0.0.1
CBE_MYSQL__PORT=3306
CBE_MYSQL__USER=<填写用户名>
CBE_MYSQL__PASSWORD=<填写真实密码>
CBE_MYSQL__DATABASE=cbe_compliance
CBE_MYSQL__CHARSET=utf8mb4
CBE_MYSQL__TIMEOUT_SECONDS=10

# ---------- 阿里云百炼（生成模型）----------
CBE_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CBE_LLM__API_KEY=<填写真实 API Key>
CBE_LLM__MODEL=qwen-plus
CBE_LLM__TIMEOUT_SECONDS=60
CBE_LLM__MAX_TOKENS=2048
CBE_LLM__TEMPERATURE=0.0

# ---------- 嵌入模型（进程内加载，无外部服务）----------
CBE_EMBEDDING__MODEL_PATH=models/bge-m3
# 固定 fp16。与已建索引的精度必须一致，不得中途切换
CBE_EMBEDDING__USE_FP16=true
CBE_EMBEDDING__DEVICE=cuda
CBE_EMBEDDING__DENSE_DIM=1024
CBE_EMBEDDING__BATCH_SIZE=8

# ---------- 检索与融合 ----------
CBE_RETRIEVAL__DENSE_LIMIT=20
CBE_RETRIEVAL__SPARSE_LIMIT=40
CBE_RETRIEVAL__DENSE_WEIGHT=0.7
CBE_RETRIEVAL__SPARSE_WEIGHT=0.3
# 拒答阈值：判据为稠密路最高余弦相似度。
# 留空表示尚未标定，检索层遇到空值必须报错而非放行。
# 首期在评测集上标定后再填这一行。
# CBE_RETRIEVAL__REFUSE_THRESHOLD=0.45
